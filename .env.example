# Sample values for BackupApp environment variables. Real values are injected
# by the Kubernetes CronJob via plain env and ExternalSecret-managed Secret.

# CouchDB connection (ClusterIP DNS, no Cloudflare Tunnel)
COUCHDB_URL=http://couchdb.databases.svc.cluster.local:5984
COUCHDB_USERNAME=obsidian-livesync-backup
COUCHDB_PASSWORD=replace-me
COUCHDB_DATABASE=obsidian-v2

# Self-hosted LiveSync E2E passphrase
LIVESYNC_PASSPHRASE=replace-me

# Backup target git repository
GIT_REPOSITORY=https://github.com/example/example-vault.git
GIT_BRANCH=main
GIT_VAULT_SUBDIR=src
GIT_TOKEN=replace-me

# Extra exclude rules (comma- or newline-separated)
EXCLUDE_PATHS=
# Regex patterns scanned against file contents; matches are masked.
EXCLUDE_SECRET_PATTERNS=
