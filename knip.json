{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "project": [
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}",
    "!vendor/**",
    "!vendor-dist/**",
    "!dist/**"
  ],
  "ignoreDependencies": [
    "@commitlint/cli",
    "@types/pouchdb",
    "diff-match-patch",
    "fflate",
    "octagonal-wheels",
    "pouchdb-adapter-http",
    "pouchdb-core",
    "pouchdb-errors",
    "pouchdb-find",
    "pouchdb-mapreduce",
    "pouchdb-merge",
    "pouchdb-replication",
    "pouchdb-utils",
    "transform-pouch"
  ],
  "ignore": ["commitlint-plugin-no-external-refs.cjs"]
}
