{
  "name": "obsidian-livesync-tools",
  "private": true,
  "workspaces": [
    "backup",
    "livesync"
  ],
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "test": "pnpm -r run test",
    "build:vendor": "node scripts/build-vendor.mjs",
    "build:app": "node scripts/build-app.mjs",
    "build": "pnpm run build:vendor && pnpm run build:app"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@fohte/eslint-config": "0.5.1",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.6",
    "@types/pouchdb": "6.4.2",
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "fflate": "0.8.3",
    "octagonal-wheels": "0.1.54",
    "pouchdb-adapter-http": "9.0.0",
    "pouchdb-core": "9.0.0",
    "pouchdb-errors": "9.0.0",
    "pouchdb-find": "9.0.0",
    "pouchdb-mapreduce": "9.0.0",
    "pouchdb-merge": "9.0.0",
    "pouchdb-replication": "9.0.0",
    "pouchdb-utils": "9.0.0",
    "prettier": "3.9.8",
    "transform-pouch": "2.0.0",
    "typescript": "6.0.3",
    "@ninoseki/eslint-plugin-neverthrow": "0.3.1",
    "vitest": "4.1.11",
    "knip": "6.37.0"
  }
}
