{
  "extends": [
    "@tsconfig/node-lts/tsconfig.json",
    "@tsconfig/strictest/tsconfig.json"
  ],
  "exclude": ["**/*.cjs", "vendor", "vendor-dist", "dist"],
  "include": [
    "src/**/*",
    "scripts/**/*",
    "vitest.config.ts",
    "eslint.config.js"
  ],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
